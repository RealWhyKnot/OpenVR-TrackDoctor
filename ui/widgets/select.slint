import { Theme } from "../theme.slint";

export component Select inherits Rectangle {
    in property <[string]> options;
    in-out property <int> current;
    callback picked(int);
    height: 24px;
    border-radius: 2px;
    background: Theme.input;
    value := Text {
        x: 8px;
        width: parent.width - 28px;
        height: parent.height;
        vertical-alignment: center;
        font-size: 14px;
        color: Theme.gray-400;
        text: root.options[root.current];
        overflow: elide;
    }
    Path {
        x: parent.width - 18px;
        y: (parent.height - 6px) / 2;
        width: 10px;
        height: 6px;
        viewbox-width: 10;
        viewbox-height: 6;
        commands: "M1 1 L5 5 L9 1";
        stroke: Theme.gray-400;
        stroke-width: 1.5px;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            popup.show();
        }
    }
    popup := PopupWindow {
        x: 0;
        y: root.height + 2px;
        width: root.width;
        Rectangle {
            background: Theme.gray-800;
            border-radius: 4px;
            border-width: 1px;
            border-color: Theme.gray-700;
            VerticalLayout {
                padding: 2px;
                for option[index] in root.options: Rectangle {
                    height: 22px;
                    border-radius: 2px;
                    background: row-touch.has-hover ? Theme.gray-700 : transparent;
                    option-label := Text {
                        x: 6px;
                        width: parent.width - 12px;
                        height: parent.height;
                        vertical-alignment: center;
                        font-size: 14px;
                        text: option;
                        color: index == root.current ? Theme.cyan-400 : Theme.gray-400;
                    }
                    row-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.current = index;
                            root.picked(index);
                        }
                    }
                }
            }
        }
    }
}
